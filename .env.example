# Copy to .env and fill in. The key never goes into the repository.
OPENROUTER_API_KEY=
# OpenRouter model ids, comma-separated, tried in order. Free models end with ":free" and share
# upstream rate limits, so list two or three. For production put a paid model first.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Optional: where handovers are POSTed as JSON (n8n webhook, ticket system). Empty = file inbox only.
HANDOVER_WEBHOOK_URL=
# Name shown in prompts and in the widget header.
COMPANY_NAME=Nordlicht Haustechnik
